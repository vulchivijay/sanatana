# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/__test__

# Allow committing Jest mocks used in CI
!/__mocks__/
!/__mocks__/*
# next.js
.next/
out/
logs/
docs

# ignore backup pages and backup components
app/_backup/
app/components/_backup/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev options
public/globals.from-scss.css
public/globals.from-scss.css.map
public/sitemap.xml
public/pdfs/
public/md_files/
public/old_files/
public/images/slider/without_reduce/
lighthouse-report.html
tmp
public/critical-home.css
.merge-json-errors
.venv
.vscode/
public/data/audit-report-csv
public/data/audit-report-json

# Additional build / cache artifacts
.cache/
dist/
.parcel-cache/
.turbo/

# Optional: local git hooks path (not committed hooks themselves)
.githooks/
# Ignore backup files
*.bak
.recovery_backups/