    "hymns": [
      {
        "id": "AV-1-1",
        "hymn_number": 1,
        "theme": "Charm Against Fever (Takman)",
        "source": "Atharvaveda 1.1 (Whitney)",
        "verses": [
          {
            "id": "AV-1-1-1",
            "sanskrit": "यदग्ने तपसा तपस्विनं ज्वरं दहसि",
            "transliteration": "yad agne tapasā tapasvinaṃ jvaraṃ dahasi",
            "meaning": {
              "literal": "O Agni, you burn the burning fever with heat.",
              "interpretive": "Agni represents transformative fire that destroys illness.",
              "applied": "Symbolizes immune response and metabolic heat."
            }
          },
          {
            "id": "AV-1-1-2",
            "sanskrit": "तं ते ज्वरं निरस्यामि",
            "transliteration": "taṃ te jvaraṃ nirasyāmi",
            "meaning": {
              "literal": "That fever of yours I drive away.",
              "interpretive": "Disease is treated as removable.",
              "applied": "Healing through active removal."
            }
          },
          {
            "id": "AV-1-1-3",
            "sanskrit": "अपगच्छ ज्वर मा पुनरागाः",
            "transliteration": "apagaccha jvara mā punar āgāḥ",
            "meaning": {
              "literal": "Go away, fever, do not return.",
              "interpretive": "Desire for permanent cure.",
              "applied": "Prevention and recovery."
            }
          }
        ]
      },
      {
        "id": "AV-1-2",
        "hymn_number": 2,
        "theme": "Charm for Healing Herbs",
        "source": "Atharvaveda 1.2",
        "verses": [
          {
            "id": "AV-1-2-1",
            "sanskrit": "ओषधयः पृथिव्यां जाताः भेषजं भवन्तु",
            "transliteration": "oṣadhayaḥ pṛthivyāṃ jātāḥ bheṣajaṃ bhavantu",
            "meaning": {
              "literal": "Herbs born of the earth become medicine.",
              "interpretive": "Plants contain healing power.",
              "applied": "Foundation of herbal medicine."
            }
          },
          {
            "id": "AV-1-2-2",
            "sanskrit": "याः दिव्या ओषधयः ताः पान्तु",
            "transliteration": "yāḥ divyā oṣadhayaḥ tāḥ pāntu",
            "meaning": {
              "literal": "Those divine herbs, may they protect.",
              "interpretive": "Healing plants are sacred.",
              "applied": "Holistic healing."
            }
          },
          {
            "id": "AV-1-2-3",
            "sanskrit": "भेषजेन त्वा चिकित्सामि",
            "transliteration": "bheṣajena tvā cikitsāmi",
            "meaning": {
              "literal": "With medicine I heal you.",
              "interpretive": "Application of remedies restores balance.",
              "applied": "Therapeutic treatment."
            }
          }
        ]
      },
      {
        "id": "AV-1-3",
        "hymn_number": 3,
        "theme": "Charm Against Evil Influences",
        "source": "Atharvaveda 1.3",
        "verses": [
          {
            "id": "AV-1-3-1",
            "sanskrit": "रक्षांसि नुदामि मन्त्रेण",
            "transliteration": "rakṣāṃsi nudāmi mantreṇa",
            "meaning": {
              "literal": "I drive away demons with mantra.",
              "interpretive": "Sound vibration dispels negativity.",
              "applied": "Mental protection."
            }
          },
          {
            "id": "AV-1-3-2",
            "sanskrit": "अभयं मे अस्तु सर्वतः",
            "transliteration": "abhayaṃ me astu sarvataḥ",
            "meaning": {
              "literal": "Let there be fearlessness from all sides.",
              "interpretive": "Protection leads to inner stability.",
              "applied": "Confidence and calm."
            }
          },
          {
            "id": "AV-1-3-3",
            "sanskrit": "मा नो दुरितं स्पृशत्",
            "transliteration": "mā no duritaṃ spṛśat",
            "meaning": {
              "literal": "Let no evil touch us.",
              "interpretive": "Avoidance of harm.",
              "applied": "Safety and well-being."
            }
          }
        ]
      },
      {
        "id": "AV-1-4",
        "hymn_number": 4,
        "theme": "Charm for Longevity and Vital Force",
        "source": "Atharvaveda 1.4",
        "verses": [
          {
            "id": "AV-1-4-1",
            "sanskrit": "दीर्घमायुर्देहि मे प्राणान् पाही",
            "transliteration": "dīrgham āyur dehi me prāṇān pāhi",
            "meaning": {
              "literal": "Grant me long life; protect my vital breaths.",
              "interpretive": "Life is sustained by prana (vital energy).",
              "applied": "Breath, vitality, and longevity practices."
            }
          },
          {
            "id": "AV-1-4-2",
            "sanskrit": "जीवेम शरदः शतम्",
            "transliteration": "jīvema śaradaḥ śatam",
            "meaning": {
              "literal": "May we live a hundred autumns.",
              "interpretive": "Ideal of full lifespan.",
              "applied": "Healthy long life aspiration."
            }
          },
          {
            "id": "AV-1-4-3",
            "sanskrit": "बलं मे देहि तनुवे",
            "transliteration": "balaṃ me dehi tanuve",
            "meaning": {
              "literal": "Give strength to my body.",
              "interpretive": "Strength supports life continuity.",
              "applied": "Physical resilience."
            }
          }
        ]
      },
      {
        "id": "AV-1-5",
        "hymn_number": 5,
        "theme": "Charm Against Poison",
        "source": "Atharvaveda 1.5",
        "verses": [
          {
            "id": "AV-1-5-1",
            "sanskrit": "विषं ते निरस्यामि अग्निना दहामि",
            "transliteration": "viṣaṃ te nirasyāmi agninā dahāmi",
            "meaning": {
              "literal": "I expel your poison; I burn it with fire.",
              "interpretive": "Fire symbolizes transformation of toxins.",
              "applied": "Detoxification process."
            }
          },
          {
            "id": "AV-1-5-2",
            "sanskrit": "अपसर्प विष मा स्पृश",
            "transliteration": "apasarpa viṣa mā spṛśa",
            "meaning": {
              "literal": "Depart, poison; do not touch.",
              "interpretive": "Commanding toxin removal.",
              "applied": "Protection from harmful substances."
            }
          },
          {
            "id": "AV-1-5-3",
            "sanskrit": "यद् विषं प्रविष्टं तन्निर्गच्छतु",
            "transliteration": "yad viṣaṃ praviṣṭaṃ tan nirgacchatu",
            "meaning": {
              "literal": "Whatever poison has entered, let it go out.",
              "interpretive": "Body expels toxins.",
              "applied": "Healing and cleansing."
            }
          }
        ]
      },
      {
        "id": "AV-1-6",
        "hymn_number": 6,
        "theme": "Charm for Victory and Strength",
        "source": "Atharvaveda 1.6",
        "verses": [
          {
            "id": "AV-1-6-1",
            "sanskrit": "इन्द्रः शत्रून् जयतु",
            "transliteration": "indraḥ śatrūn jayatu",
            "meaning": {
              "literal": "May Indra conquer the enemies.",
              "interpretive": "Indra symbolizes power and dominance.",
              "applied": "Overcoming challenges."
            }
          },
          {
            "id": "AV-1-6-2",
            "sanskrit": "अभिभव शत्रून् बलिना",
            "transliteration": "abhibhava śatrūn balinā",
            "meaning": {
              "literal": "Overcome enemies with strength.",
              "interpretive": "Strength ensures victory.",
              "applied": "Confidence and assertiveness."
            }
          },
          {
            "id": "AV-1-6-3",
            "sanskrit": "जयामि सर्वान् अहं वीर्येण",
            "transliteration": "jayāmi sarvān ahaṃ vīryeṇa",
            "meaning": {
              "literal": "I conquer all through vigor.",
              "interpretive": "Self-effort leads to success.",
              "applied": "Personal empowerment."
            }
          }
        ]
      },
      {
        "id": "AV-1-7",
        "hymn_number": 7,
        "theme": "Charm for Peace and Well-being",
        "source": "Atharvaveda 1.7",
        "verses": [
          {
            "id": "AV-1-7-1",
            "sanskrit": "शं नो अस्तु द्विपदे शं चतुष्पदे",
            "transliteration": "śaṃ no astu dvipade śaṃ catuṣpade",
            "meaning": {
              "literal": "May there be peace for bipeds and quadrupeds.",
              "interpretive": "Harmony extends to all living beings.",
              "applied": "Universal well-being."
            }
          },
          {
            "id": "AV-1-7-2",
            "sanskrit": "शं नो मित्रः शं वरुणः",
            "transliteration": "śaṃ no mitraḥ śaṃ varuṇaḥ",
            "meaning": {
              "literal": "May Mitra and Varuna grant us peace.",
              "interpretive": "Cosmic forces ensure harmony.",
              "applied": "Balanced life."
            }
          },
          {
            "id": "AV-1-7-3",
            "sanskrit": "शान्तिः शान्तिः शान्तिः",
            "transliteration": "śāntiḥ śāntiḥ śāntiḥ",
            "meaning": {
              "literal": "Peace, peace, peace.",
              "interpretive": "Peace in all dimensions.",
              "applied": "Holistic calm."
            }
          }
        ]
      },
      {
        "id": "AV-1-8",
        "hymn_number": 8,
        "theme": "Charm for Removal of Disease",
        "source": "Atharvaveda 1.8",
        "verses": [
          {
            "id": "AV-1-8-1",
            "sanskrit": "यद् रोगं तन्वोऽपगच्छतु",
            "transliteration": "yad rogaṃ tanvo'pagacchatu",
            "meaning": {
              "literal": "Let the disease depart from the body.",
              "interpretive": "Disease is separable from self.",
              "applied": "Healing process."
            }
          },
          {
            "id": "AV-1-8-2",
            "sanskrit": "बलं मे पुनरागच्छतु",
            "transliteration": "balaṃ me punar āgacchatu",
            "meaning": {
              "literal": "Let strength return to me.",
              "interpretive": "Healing restores vitality.",
              "applied": "Recovery."
            }
          },
          {
            "id": "AV-1-8-3",
            "sanskrit": "अग्निः पावकः शुद्धये",
            "transliteration": "agniḥ pāvakaḥ śuddhaye",
            "meaning": {
              "literal": "Agni purifies for cleansing.",
              "interpretive": "Fire cleanses impurities.",
              "applied": "Detox and purification."
            }
          }
        ]
      },
      {
        "id": "AV-1-9",
        "hymn_number": 9,
        "theme": "Charm for Protection of the Body",
        "source": "Atharvaveda 1.9",
        "verses": [
          {
            "id": "AV-1-9-1",
            "sanskrit": "तनुं मे पातु देवाः सर्वतः",
            "transliteration": "tanuṃ me pātu devāḥ sarvataḥ",
            "meaning": {
              "literal": "May the gods protect my body from all sides.",
              "interpretive": "Divine protection surrounds the individual.",
              "applied": "Holistic safety."
            }
          },
          {
            "id": "AV-1-9-2",
            "sanskrit": "मा मां हिंसीत् कश्चन",
            "transliteration": "mā māṃ hiṃsīt kaścana",
            "meaning": {
              "literal": "Let no one harm me.",
              "interpretive": "Protection from harm.",
              "applied": "Security and safety."
            }
          },
          {
            "id": "AV-1-9-3",
            "sanskrit": "अभयं मे अस्तु सर्वतः",
            "transliteration": "abhayaṃ me astu sarvataḥ",
            "meaning": {
              "literal": "Let there be fearlessness everywhere.",
              "interpretive": "Fearlessness through protection.",
              "applied": "Confidence."
            }
          }
        ]
      },
      {
        "id": "AV-1-10",
        "hymn_number": 10,
        "theme": "Charm for Purification and Release from Sin",
        "source": "Atharvaveda 1.10",
        "verses": [
          {
            "id": "AV-1-10-1",
            "sanskrit": "पापं मे अपगच्छतु दूरं गच्छ",
            "transliteration": "pāpaṃ me apagacchatu dūraṃ gaccha",
            "meaning": {
              "literal": "Let sin depart from me, go far away.",
              "interpretive": "Negativity is removable.",
              "applied": "Moral and mental cleansing."
            }
          },
          {
            "id": "AV-1-10-2",
            "sanskrit": "शुद्धोऽहमस्मि पवित्रेण",
            "transliteration": "śuddho'ham asmi pavitreṇa",
            "meaning": {
              "literal": "I am purified by the purifier.",
              "interpretive": "Purity is a state achieved through cleansing.",
              "applied": "Inner renewal."
            }
          },
          {
            "id": "AV-1-10-3",
            "sanskrit": "अग्निः पावकः पातु माम्",
            "transliteration": "agniḥ pāvakaḥ pātu mām",
            "meaning": {
              "literal": "Agni the purifier protects me.",
              "interpretive": "Fire cleanses and safeguards.",
              "applied": "Spiritual purification."
            }
          }
        ]
      },
      {
        "id": "AV-1-11",
        "hymn_number": 11,
        "theme": "Harmony with Natural Forces",
        "source": "Atharvaveda 1.11",
        "verses": [
          {
            "id": "AV-1-11-1",
            "sanskrit": "पृथिवी मे शं करोतु",
            "transliteration": "pṛthivī me śaṃ karotu",
            "meaning": {
              "literal": "May Earth bring me peace.",
              "interpretive": "Earth nurtures life.",
              "applied": "Grounding and stability."
            }
          },
          {
            "id": "AV-1-11-2",
            "sanskrit": "आपः शं नो भवन्तु",
            "transliteration": "āpaḥ śaṃ no bhavantu",
            "meaning": {
              "literal": "May the waters bring us peace.",
              "interpretive": "Water purifies and sustains.",
              "applied": "Cleansing and renewal."
            }
          },
          {
            "id": "AV-1-11-3",
            "sanskrit": "वायुः प्राणो जीवने",
            "transliteration": "vāyuḥ prāṇo jīvane",
            "meaning": {
              "literal": "Air is the life-breath in living.",
              "interpretive": "Air sustains life force.",
              "applied": "Breathing and vitality."
            }
          }
        ]
      },
      {
        "id": "AV-1-12",
        "hymn_number": 12,
        "theme": "Strength and Stability",
        "source": "Atharvaveda 1.12",
        "verses": [
          {
            "id": "AV-1-12-1",
            "sanskrit": "स्थिरो भवामि धृत्या",
            "transliteration": "sthiro bhavāmi dhṛtyā",
            "meaning": {
              "literal": "I become stable through firmness.",
              "interpretive": "Stability arises from inner strength.",
              "applied": "Mental resilience."
            }
          },
          {
            "id": "AV-1-12-2",
            "sanskrit": "बलं मे अस्तु तनुवे",
            "transliteration": "balaṃ me astu tanuve",
            "meaning": {
              "literal": "Let strength be in my body.",
              "interpretive": "Strength supports existence.",
              "applied": "Physical health."
            }
          },
          {
            "id": "AV-1-12-3",
            "sanskrit": "धैर्यं मे देहि",
            "transliteration": "dhairyaṃ me dehi",
            "meaning": {
              "literal": "Grant me courage.",
              "interpretive": "Courage sustains effort.",
              "applied": "Confidence and perseverance."
            }
          }
        ]
      },
      {
        "id": "AV-1-13",
        "hymn_number": 13,
        "theme": "Charm Against Fever (Takman – Advanced)",
        "source": "Atharvaveda 1.13",
        "verses": [
          {
            "id": "AV-1-13-1",
            "sanskrit": "तकमन् त्वा निरस्यामि दूरं गच्छ",
            "transliteration": "takman tvā nirasyāmi dūraṃ gaccha",
            "meaning": {
              "literal": "O fever, I expel you—go far away.",
              "interpretive": "Disease is externalized and removed.",
              "applied": "Healing through expulsion."
            }
          },
          {
            "id": "AV-1-13-2",
            "sanskrit": "यत्र न स्याः पुनरागाः",
            "transliteration": "yatra na syāḥ punar āgāḥ",
            "meaning": {
              "literal": "Go where you do not return.",
              "interpretive": "Desire for permanent cure.",
              "applied": "Prevention of relapse."
            }
          },
          {
            "id": "AV-1-13-3",
            "sanskrit": "अग्निस्त्वा दहतु पावकः",
            "transliteration": "agnis tvā dahatu pāvakaḥ",
            "meaning": {
              "literal": "May purifying fire burn you.",
              "interpretive": "Fire destroys disease.",
              "applied": "Thermal purification."
            }
          }
        ]
      },
      {
        "id": "AV-1-14",
        "hymn_number": 14,
        "theme": "Charm for Regeneration and Healing",
        "source": "Atharvaveda 1.14",
        "verses": [
          {
            "id": "AV-1-14-1",
            "sanskrit": "यथा वृक्षस्य छिन्नं पुनः संवर्धते",
            "transliteration": "yathā vṛkṣasya chinnaṃ punaḥ saṃvardhate",
            "meaning": {
              "literal": "As a cut tree grows again.",
              "interpretive": "Nature demonstrates regeneration.",
              "applied": "Healing and recovery."
            }
          },
          {
            "id": "AV-1-14-2",
            "sanskrit": "एवं मे अङ्गं पुनः रोहतु",
            "transliteration": "evaṃ me aṅgaṃ punaḥ rohatu",
            "meaning": {
              "literal": "So may my limb grow again.",
              "interpretive": "Body restores itself.",
              "applied": "Tissue regeneration."
            }
          },
          {
            "id": "AV-1-14-3",
            "sanskrit": "ओषधयः मे रोपयन्तु",
            "transliteration": "oṣadhayaḥ me ropayantu",
            "meaning": {
              "literal": "May herbs restore me.",
              "interpretive": "Plants assist healing.",
              "applied": "Herbal recovery."
