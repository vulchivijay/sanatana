          }
        ]
      },
      {
        "id": "AV-1-15",
        "hymn_number": 15,
        "theme": "Charm Against Sorcery and Harmful Intent",
        "source": "Atharvaveda 1.15",
        "verses": [
          {
            "id": "AV-1-15-1",
            "sanskrit": "यद् अभिचारं कृतं तद् निवर्तयामि",
            "transliteration": "yad abhichāraṃ kṛtaṃ tad nivartayāmi",
            "meaning": {
              "literal": "Whatever sorcery has been done, I turn it back.",
              "interpretive": "Neutralization of harmful intent.",
              "applied": "Psychological protection."
            }
          },
          {
            "id": "AV-1-15-2",
            "sanskrit": "मन्त्रेण तद् भिन्दामि",
            "transliteration": "mantreṇa tad bhindāmi",
            "meaning": {
              "literal": "By mantra I break it.",
              "interpretive": "Sound dismantles negativity.",
              "applied": "Affirmation as defense."
            }
          },
          {
            "id": "AV-1-15-3",
            "sanskrit": "मा नो दुरितं स्पृशत्",
            "transliteration": "mā no duritaṃ spṛśat",
            "meaning": {
              "literal": "Let no evil touch us.",
              "interpretive": "Protection from harm.",
              "applied": "Safety and well-being."
            }
          }
        ]
      },
      {
        "id": "AV-1-16",
        "hymn_number": 16,
        "theme": "Charm for Harmony in Household",
        "source": "Atharvaveda 1.16",
        "verses": [
          {
            "id": "AV-1-16-1",
            "sanskrit": "समानो मनः सह चित्तम् अस्तु",
            "transliteration": "samāno manaḥ saha cittam astu",
            "meaning": {
              "literal": "Let the mind be united and thoughts together.",
              "interpretive": "Unity of minds creates harmony.",
              "applied": "Healthy relationships."
            }
          },
          {
            "id": "AV-1-16-2",
            "sanskrit": "समानं वः हृदयं अस्तु",
            "transliteration": "samānaṃ vaḥ hṛdayaṃ astu",
            "meaning": {
              "literal": "Let your hearts be one.",
              "interpretive": "Emotional unity strengthens bonds.",
              "applied": "Family peace."
            }
          },
          {
            "id": "AV-1-16-3",
            "sanskrit": "मा विभेदः भवतु",
            "transliteration": "mā vibhedaḥ bhavatu",
            "meaning": {
              "literal": "Let there be no division.",
              "interpretive": "Avoidance of conflict.",
              "applied": "Conflict resolution."
            }
          }
        ]
      },
      {
        "id": "AV-1-17",
        "hymn_number": 17,
        "theme": "Charm for Prosperity and Growth",
        "source": "Atharvaveda 1.17",
        "verses": [
          {
            "id": "AV-1-17-1",
            "sanskrit": "वृद्धिं मे देहि",
