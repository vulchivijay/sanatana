            "id": "AV-1-17-2",
            "sanskrit": "धनं मे आगच्छतु",
            "transliteration": "dhanaṃ me āgacchatu",
            "meaning": {
              "literal": "Let wealth come to me.",
              "interpretive": "Resources support life.",
              "applied": "Financial stability."
            }
