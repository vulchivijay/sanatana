            }
          }
        ]
      },
      {
        "id": "AV-3-9",
        "hymn_number": 9,
        "theme": "Charm for Protection of Body and Life",
        "source": "Atharvaveda 3.9",
        "verses": [
          {
            "id": "AV-3-9-1",
            "sanskrit": "तनुं मे पातु देवाः सर्वतः",
            "transliteration": "tanuṃ me pātu devāḥ sarvataḥ",
            "meaning": {
              "literal": "May the gods protect my body from all sides.",
              "interpretive": "Divine protection surrounds the individual.",
              "applied": "Holistic safety."
            }
          },
          {
            "id": "AV-3-9-2",
            "sanskrit": "मा मां हिंसीत् कश्चन",
            "transliteration": "mā māṃ hiṃsīt kaścana",
            "meaning": {
              "literal": "Let no one harm me.",
              "interpretive": "Protection from harm.",
              "applied": "Security."
            }
          },
          {
            "id": "AV-3-9-3",
            "sanskrit": "अभयं मे अस्तु सर्वतः",
            "transliteration": "abhayaṃ me astu sarvataḥ",
            "meaning": {
              "literal": "Let there be fearlessness everywhere.",
              "interpretive": "Protection removes fear.",
              "applied": "Confidence."
            }
          }
        ]
      },
      {
        "id": "AV-4-10",
        "hymn_number": 10,
        "theme": "Charm for Purification and Release from Sin",
        "source": "Atharvaveda 4.10",
        "verses": [
          {
            "id": "AV-4-10-1",
            "sanskrit": "पापं मे अपगच्छतु दूरं गच्छ",
            "transliteration": "pāpaṃ me apagacchatu dūraṃ gaccha",
            "meaning": {
              "literal": "Let sin depart from me, go far away.",
              "interpretive": "Impurity is removable.",
              "applied": "Moral cleansing."
            }
          },
          {
            "id": "AV-4-10-2",
            "sanskrit": "शुद्धोऽहमस्मि पवित्रेण",
            "transliteration": "śuddho'ham asmi pavitreṇa",
            "meaning": {
              "literal": "I am purified by the purifier.",
              "interpretive": "Purification restores balance.",
              "applied": "Inner renewal."
            }
          },
          {
            "id": "AV-4-10-3",
            "sanskrit": "अग्निः पावकः पातु माम्",
            "transliteration": "agniḥ pāvakaḥ pātu mām",
            "meaning": {
              "literal": "Agni the purifier protects me.",
              "interpretive": "Fire cleanses and safeguards.",
              "applied": "Spiritual purification."
            }
          }
        ]
      },
      {
        "id": "AV-4-11",
        "hymn_number": 11,
        "theme": "Harmony with Natural Elements",
        "source": "Atharvaveda 4.11",
        "verses": [
          {
            "id": "AV-4-11-1",
            "sanskrit": "पृथिवी मे शं करोतु",
            "transliteration": "pṛthivī me śaṃ karotu",
            "meaning": {
              "literal": "May Earth bring me peace.",
              "interpretive": "Earth sustains life.",
              "applied": "Grounding."
            }
          },
          {
            "id": "AV-4-11-2",
            "sanskrit": "आपः शं नो भवन्तु",
            "transliteration": "āpaḥ śaṃ no bhavantu",
            "meaning": {
              "literal": "May waters bring us peace.",
              "interpretive": "Water purifies and nourishes.",
              "applied": "Cleansing."
            }
          },
          {
            "id": "AV-4-11-3",
            "sanskrit": "वायुः प्राणो जीवने",
            "transliteration": "vāyuḥ prāṇo jīvane",
            "meaning": {
              "literal": "Air is the life-breath.",
              "interpretive": "Air sustains life force.",
              "applied": "Vitality."
            }
          }
        ]
      },
      {
        "id": "AV-4-12",
        "hymn_number": 12,
        "theme": "Charm for Strength and Stability",
        "source": "Atharvaveda 4.12",
        "verses": [
          {
            "id": "AV-4-12-1",
            "sanskrit": "स्थिरो भवामि धृत्या",
            "transliteration": "sthiro bhavāmi dhṛtyā",
            "meaning": {
              "literal": "I become stable through firmness.",
              "interpretive": "Stability arises from strength.",
              "applied": "Mental resilience."
            }
          },
          {
            "id": "AV-4-12-2",
            "sanskrit": "बलं मे अस्तु तनुवे",
            "transliteration": "balaṃ me astu tanuve",
            "meaning": {
              "literal": "Let strength be in my body.",
              "interpretive": "Strength supports existence.",
              "applied": "Physical health."
            }
          },
          {
            "id": "AV-4-12-3",
            "sanskrit": "धैर्यं मे देहि",
            "transliteration": "dhairyaṃ me dehi",
            "meaning": {
              "literal": "Grant me courage.",
              "interpretive": "Courage sustains effort.",
              "applied": "Confidence."
            }
          }
        ]
      },
      {
        "id": "AV-4-13",
        "hymn_number": 13,
        "deity": "Agni",
        "theme": "Protection and purification",
        "source": "Atharvaveda 4.13",
        "verses": [
          {
            "id": "AV-4-13-1",
            "sanskrit": "अग्ने पावक दीदिहि रक्ष नः सर्वतो भयात्",
            "transliteration": "agne pāvaka dīdihi rakṣa naḥ sarvato bhayāt",
            "meaning": {
              "literal": "O radiant Agni, shine and protect us from all fear.",
              "interpretive": "Fire acts as a purifier and guardian.",
              "applied": "Protection from negative influences."
            }
          },
          {
            "id": "AV-4-13-2",
            "sanskrit": "त्वं नः पापं दहसि विश्वतो नः परित्राहि",
            "transliteration": "tvaṁ naḥ pāpaṁ dahasi viśvato naḥ paritrāhi",
            "meaning": {
              "literal": "You burn away sin and protect us from all sides.",
              "interpretive": "Agni removes impurities and safeguards life.",
              "applied": "Spiritual cleansing."
            }
          },
          {
            "id": "AV-4-13-3",
            "sanskrit": "अग्निर्नः पातु गृहपतिः शुभं करोतु",
            "transliteration": "agnir naḥ pātu gṛhapatiḥ śubhaṁ karotu",
            "meaning": {
              "literal": "May Agni, lord of the home, protect us and bring auspiciousness.",
              "interpretive": "Agni sustains domestic harmony.",
              "applied": "Household well-being."
            }
          }
        ],
        "application": "Used in fire rituals for purification, protection, and domestic peace",
        "philosophy": "Agni symbolizes transformation—turning impurity into purity and fear into strength"
      },
      {
        "id": "AV-4-14",
        "hymn_number": 14,
        "deity": "Vayu (Air / Prana)",
        "theme": "Vital energy and life-force",
        "source": "Atharvaveda 4.14",
        "verses": [
          {
            "id": "AV-4-14-1",
            "sanskrit": "वायुः प्राणो जीवने सर्वं धारयति",
            "transliteration": "vāyuḥ prāṇo jīvane sarvaṁ dhārayati",
            "meaning": {
              "literal": "Air, the life-breath, sustains all existence.",
              "interpretive": "Prana is the fundamental life force.",
              "applied": "Breath awareness and vitality."
            }
          },
          {
            "id": "AV-4-14-2",
            "sanskrit": "प्राणाः मे बलं दधतु आयुः वर्धयन्तु",
            "transliteration": "prāṇāḥ me balaṁ dadhatu āyuḥ vardhayantu",
            "meaning": {
              "literal": "May the life-breaths give me strength and increase lifespan.",
              "interpretive": "Balanced prana leads to health and longevity.",
              "applied": "Energy and endurance."
            }
          },
          {
            "id": "AV-4-14-3",
            "sanskrit": "वायोः शक्त्या जीवामि दीर्घमायुः",
            "transliteration": "vāyoḥ śaktyā jīvāmi dīrgham āyuḥ",
            "meaning": {
              "literal": "By the power of air, I live a long life.",
              "interpretive": "Life is sustained through breath and energy flow.",
              "applied": "Longevity practices."
            }
