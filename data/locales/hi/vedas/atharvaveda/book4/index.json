        "application": "Used in breathing rituals, vitality enhancement, and health practices",
        "philosophy": "Prana (life-force) connects body, mind, and cosmos"
      },
      {
        "id": "AV-4-15",
        "hymn_number": 15,
        "deity": "Brahman (Cosmic Principle)",
        "theme": "Unity and universal consciousness",
        "source": "Atharvaveda 4.15",
        "verses": [
          {
            "id": "AV-4-15-1",
            "sanskrit": "ब्रह्म सर्वं प्रतिष्ठितं यत्र विश्वं निहितं महत्",
            "transliteration": "brahma sarvaṁ pratiṣṭhitaṁ yatra viśvaṁ nihitaṁ mahat",
            "meaning": {
              "literal": "In Brahman all is established; the universe rests within it.",
              "interpretive": "Ultimate reality is the foundation of existence.",
              "applied": "Meditation on unity."
            }
          },
          {
            "id": "AV-4-15-2",
            "sanskrit": "एको देवः सर्वभूतेषु गूढः सर्वव्यापी सनातनः",
            "transliteration": "eko devaḥ sarvabhūteṣu gūḍhaḥ sarvavyāpī sanātanaḥ",
            "meaning": {
              "literal": "One divine reality dwells hidden in all beings.",
              "interpretive": "Divinity is present everywhere.",
              "applied": "Universal awareness."
            }
          },
          {
            "id": "AV-4-15-3",
            "sanskrit": "तत् सत्यं ज्ञानमेकं सर्वभूताधारम्",
            "transliteration": "tat satyaṁ jñānam ekaṁ sarvabhūtādhāram",
            "meaning": {
              "literal": "That is truth, knowledge, and the support of all beings.",
              "interpretive": "Brahman is ultimate truth and consciousness.",
              "applied": "Spiritual realization."
            }
          }
        ],
        "application": "Used in meditation, philosophical contemplation, and spiritual study",
        "philosophy": "All existence is unified in one cosmic consciousness (Brahman)"
      },
      {
        "id": "AV-4-16",
        "hymn_number": 16,
        "theme": "Charm for Harmony and Unity",
        "source": "Atharvaveda 4.16",
        "verses": [
          {
            "id": "AV-4-16-1",
            "sanskrit": "समानो मनः सह चित्तम् अस्तु",
            "transliteration": "samāno manaḥ saha cittam astu",
            "meaning": {
              "literal": "Let minds be united and thoughts together.",
              "interpretive": "Unity creates harmony.",
              "applied": "Relationships."
            }
          },
          {
            "id": "AV-4-16-2",
            "sanskrit": "समानं वः हृदयं अस्तु",
            "transliteration": "samānaṃ vaḥ hṛdayaṃ astu",
            "meaning": {
              "literal": "Let hearts be one.",
              "interpretive": "Emotional unity strengthens bonds.",
              "applied": "Family harmony."
            }
          },
          {
            "id": "AV-4-16-3",
            "sanskrit": "मा विभेदः भवतु",
            "transliteration": "mā vibhedaḥ bhavatu",
            "meaning": {
              "literal": "Let there be no division.",
              "interpretive": "Avoid conflict.",
              "applied": "Peaceful coexistence."
            }
          }
        ]
      },
      {
        "id": "AV-4-17",
        "hymn_number": 17,
        "theme": "Charm for Prosperity and Growth",
        "source": "Atharvaveda 4.17",
        "verses": [
          {
