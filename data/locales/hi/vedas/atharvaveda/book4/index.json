            }
          },
          {
            "id": "AV-3-8-3",
            "sanskrit": "बलं मे पुनरागच्छतु",
            "transliteration": "balaṃ me punar āgacchatu",
            "meaning": {
              "literal": "Let strength return to me.",
              "interpretive": "Recovery restores power.",
