      {
        "hymn_id": 25,
        "deity": "Agni",
        "theme": "Protection and household well-being",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "अग्ने गृहपतिं वयं हवामहे शुभं कृणु।",
            "transliteration": "agne gṛhapatiṁ vayaṁ havāmahe śubhaṁ kṛṇu |",
            "meaning": "O Agni, lord of the household, we invoke you—bring auspiciousness."
          },
          {
            "verse_id": 2,
            "sanskrit": "त्वं नः पातु सर्वतः शं नो अस्तु सदा गृहे।",
            "transliteration": "tvaṁ naḥ pātu sarvataḥ śaṁ no astu sadā gṛhe |",
            "meaning": "Protect us from all directions; let there always be peace in our home."
          }
        ],
        "application": "Household protection rituals and domestic harmony prayers",
        "philosophy": "Agni represents both physical fire and the sustaining spiritual energy of the home"
      },
      {
        "hymn_id": 26,
        "deity": "Indra",
        "theme": "Victory and overcoming obstacles",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "इन्द्रं वर्धन्तो अप्तुरः कृण्वाना यज्ञमुत्तमम्।",
            "transliteration": "indraṁ vardhanto apturaḥ kṛṇvānā yajñam uttamam |",
            "meaning": "Exalting Indra, we perform the supreme sacrifice with strength."
          },
          {
            "verse_id": 2,
            "sanskrit": "स नो बलं ददातु विजयं च परत्र च।",
            "transliteration": "sa no balaṁ dadātu vijayaṁ ca paratra ca |",
            "meaning": "May he grant us strength and victory, both here and beyond."
          }
        ],
        "application": "Used in times of conflict, challenges, and competitive endeavors",
        "philosophy": "Inner strength and divine support are essential for overcoming adversity"
      },  
      {
        "hymn_id": 27,
        "deity": "Varuna",
        "theme": "Moral order and forgiveness",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "वरुणं राजानं हवामहे सत्यधर्माणमद्भुतम्।",
            "transliteration": "varuṇaṁ rājānaṁ havāmahe satyadharmāṇam adbhutam |",
            "meaning": "We invoke King Varuna, the upholder of truth and cosmic law."
          },
          {
            "verse_id": 2,
            "sanskrit": "यद् अघं कृतं मया तन्मे क्षमस्व सुशेव नः।",
            "transliteration": "yad aghaṁ kṛtaṁ mayā tan me kṣamasva suśeva naḥ |",
            "meaning": "Forgive whatever sin I have committed; be gracious to us."
          }
        ],
        "application": "Repentance rituals and prayers for moral purification",
        "philosophy": "Alignment with cosmic order (ṛta) leads to harmony and forgiveness"
      },
      {
        "id": "AV-7-28",
        "hymn_number": 28,
        "theme": "Charm for Strength and Courage",
        "source": "Atharvaveda 7.28",
        "verses": [
          {
            "id": "AV-7-28-1",
            "sanskrit": "वीर्यं मे अस्तु बलं मे वर्धताम्",
            "transliteration": "vīryaṃ me astu balaṃ me vardhatām",
            "meaning": {
              "literal": "May vigor be mine and strength increase.",
              "interpretive": "Energy enables action.",
              "applied": "Motivation."
            }
          },
          {
            "id": "AV-7-28-2",
            "sanskrit": "धैर्यं मे देहि दृढम्",
            "transliteration": "dhairyaṃ me dehi dṛḍham",
            "meaning": {
              "literal": "Grant me firm courage.",
              "interpretive": "Courage sustains effort.",
              "applied": "Resilience."
            }
          },
          {
            "id": "AV-7-28-3",
            "sanskrit": "उत्साहो मे वर्धताम्",
            "transliteration": "utsāho me vardhatām",
            "meaning": {
              "literal": "May enthusiasm increase.",
              "interpretive": "Drive fuels progress.",
              "applied": "Productivity."
            }
          }
        ]
      },
      {
        "id": "AV-7-29",
        "hymn_number": 29,
        "theme": "Charm for Prosperity and Wealth",
        "source": "Atharvaveda 7.29",
        "verses": [
          {
            "id": "AV-7-29-1",
            "sanskrit": "धनं मे आगच्छतु रयिं मे देहि",
            "transliteration": "dhanaṃ me āgacchatu rayiṃ me dehi",
            "meaning": {
              "literal": "Let wealth come to me, grant me resources.",
              "interpretive": "Material support is essential.",
              "applied": "Financial stability."
            }
          },
          {
            "id": "AV-7-29-2",
            "sanskrit": "समृद्धिर्मे वर्धताम्",
            "transliteration": "samṛddhir me vardhatām",
            "meaning": {
              "literal": "May prosperity increase.",
              "interpretive": "Abundance reflects balance.",
              "applied": "Sustainable growth."
            }
          },
          {
            "id": "AV-7-29-3",
            "sanskrit": "भाग्यं मे अस्तु सर्वदा",
            "transliteration": "bhāgyaṃ me astu sarvadā",
            "meaning": {
              "literal": "May fortune be mine always.",
              "interpretive": "Fortune supports success.",
              "applied": "Stability."
            }
          }
        ]
      },
      {
        "id": "AV-7-30",
        "hymn_number": 30,
        "theme": "Universal Peace Invocation",
        "source": "Atharvaveda 7.30",
        "verses": [
          {
            "id": "AV-7-30-1",
            "sanskrit": "शं नो मित्रः शं वरुणः",
            "transliteration": "śaṃ no mitraḥ śaṃ varuṇaḥ",
            "meaning": {
              "literal": "May Mitra and Varuna bring peace.",
              "interpretive": "Cosmic harmony.",
              "applied": "Balanced relationships."
            }
          },
          {
            "id": "AV-7-30-2",
            "sanskrit": "शं नो भवत्वर्यमा",
            "transliteration": "śaṃ no bhavatv aryamā",
            "meaning": {
              "literal": "May Aryaman bring peace.",
              "interpretive": "Social harmony.",
              "applied": "Community balance."
            }
          },
          {
            "id": "AV-7-30-3",
            "sanskrit": "शान्तिः शान्तिः शान्तिः",
            "transliteration": "śāntiḥ śāntiḥ śāntiḥ",
