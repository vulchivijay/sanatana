      {
        "hymn_id": 13,
        "deity": "Herbs (Oshadhi)",
        "theme": "Healing and restoration",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "ओषधयः सं भवन्तु भेषजं रोगनाशनम्।",
            "transliteration": "oṣadhayaḥ saṁ bhavantu bheṣajaṁ roganāśanam |",
            "meaning": "Let the herbs unite to become medicine that destroys disease."
          },
          {
            "verse_id": 2,
            "sanskrit": "याः पृथिव्यां दिवि जाताः ताः नः शं करोतु वै।",
            "transliteration": "yāḥ pṛthivyāṁ divi jātāḥ tāḥ naḥ śaṁ karotu vai |",
            "meaning": "Those herbs born on earth and in heaven—may they bring us well-being."
          }
        ],
        "application": "Used in herbal healing rituals and Ayurvedic practices",
        "philosophy": "Nature embodies divine healing intelligence"
      },
      {
        "hymn_id": 14,
        "deity": "Water (Apah)",
        "theme": "Purification and life energy",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "आपः शुद्धयन्तु नः सर्वं जीवनं धारयन्तु च।",
            "transliteration": "āpaḥ śuddhayantu naḥ sarvaṁ jīvanaṁ dhārayantu ca |",
            "meaning": "May the waters purify us and sustain all life."
          },
          {
            "verse_id": 2,
            "sanskrit": "आपो हि जीवनस्य मूलं तासु नः शक्तिर्धीयताम्।",
            "transliteration": "āpo hi jīvanasya mūlaṁ tāsu naḥ śaktir dhīyatām |",
            "meaning": "Water is the root of life; may it grant us strength."
          }
        ],
        "application": "Purification rites, sacred bathing, and healing rituals",
        "philosophy": "Water symbolizes renewal, flow, and purification of existence"
      },
      {
        "hymn_id": 15,
        "deity": "Agni",
        "theme": "Protection and transformation",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "अग्ने पावक दीदिहि रक्ष नः सर्वतो भयात्।",
            "transliteration": "agne pāvaka dīdihi rakṣa naḥ sarvato bhayāt |",
            "meaning": "O radiant Agni, shine forth and protect us from all fear."
          },
          {
            "verse_id": 2,
            "sanskrit": "त्वं नः पापं दहसि विश्वतो नः परित्राहि।",
            "transliteration": "tvaṁ naḥ pāpaṁ dahasi viśvato naḥ paritrāhi |",
            "meaning": "You burn away sin and protect us from all sides."
          }
        ],
        "application": "Fire rituals for protection and purification",
        "philosophy": "Fire transforms negativity into purity and light"
      },
      {
        "id": "AV-5-16",
        "hymn_number": 16,
        "theme": "Charm for Harmony and Unity",
        "source": "Atharvaveda 5.16",
        "verses": [
          {
            "id": "AV-5-16-1",
            "sanskrit": "समानो मनः सह चित्तम् अस्तु",
            "transliteration": "samāno manaḥ saha cittam astu",
            "meaning": {
              "literal": "Let minds be united and thoughts together.",
              "interpretive": "Unity creates harmony.",
              "applied": "Relationships."
            }
          },
          {
            "id": "AV-5-16-2",
            "sanskrit": "समानं वः हृदयं अस्तु",
            "transliteration": "samānaṃ vaḥ hṛdayaṃ astu",
            "meaning": {
              "literal": "Let hearts be one.",
              "interpretive": "Emotional unity strengthens bonds.",
              "applied": "Family harmony."
            }
          },
          {
            "id": "AV-5-16-3",
            "sanskrit": "मा विभेदः भवतु",
