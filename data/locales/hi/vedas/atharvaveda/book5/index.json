      {
        "hymn_id": 21,
        "deity": "Brahman",
        "theme": "Unity and cosmic consciousness",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "ब्रह्म सर्वं प्रतिष्ठितं यत्र विश्वं प्रतिष्ठितम्।",
            "transliteration": "brahma sarvaṁ pratiṣṭhitaṁ yatra viśvaṁ pratiṣṭhitam |",
