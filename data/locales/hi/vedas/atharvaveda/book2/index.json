          {
            "id": "AV-2-25-2",
            "sanskrit": "शुभं मे अस्तु",
            "transliteration": "śubhaṃ me astu",
            "meaning": {
              "literal": "Let there be auspiciousness for me.",
              "interpretive": "Alignment with favorable forces.",
              "applied": "Optimism."
            }
          },
          {
            "id": "AV-2-25-3",
            "sanskrit": "भाग्यं मे वर्धताम्",
            "transliteration": "bhāgyaṃ me vardhatām",
            "meaning": {
              "literal": "May fortune increase.",
              "interpretive": "Growth of positive conditions.",
              "applied": "Success mindset."
            }
          }
        ]
      },
      {
        "id": "AV-2-26",
