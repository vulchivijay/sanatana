              "literal": "Let no one harm me.",
              "interpretive": "Protection from aggression.",
              "applied": "Safety."
            }
          },
          {
            "id": "AV-2-24-3",
            "sanskrit": "अभयं मे अस्तु",
            "transliteration": "abhayaṃ me astu",
