          {
            "id": "AV-2-26-3",
            "sanskrit": "धियो यो नः प्रचोदयात्",
            "transliteration": "dhiyo yo naḥ pracodayāt",
            "meaning": {
              "literal": "May he inspire our intellects.",
              "interpretive": "Divine guidance enhances mind.",
              "applied": "Clarity."
            }
          }
        ]
      },
      {
        "id": "AV-2-27",
