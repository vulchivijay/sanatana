      {
        "id": "AV-2-25",
        "hymn_number": 25,
        "theme": "Charm for Removal of Misfortune",
        "source": "Atharvaveda 2.25",
        "verses": [
          {
            "id": "AV-2-25-1",
            "sanskrit": "दुर्भाग्यं दूरं गच्छतु",
