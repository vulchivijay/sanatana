        "theme": "Charm for Intelligence (Medha)",
        "source": "Atharvaveda 2.26",
        "verses": [
          {
            "id": "AV-2-26-1",
            "sanskrit": "मेधां मे देहि",
            "transliteration": "medhāṃ me dehi",
            "meaning": {
              "literal": "Grant me intelligence.",
              "interpretive": "Intellect is divine.",
              "applied": "Learning ability."
            }
