            "id": "AV-2-26-2",
            "sanskrit": "प्रज्ञां मे अस्तु",
            "transliteration": "prajñāṃ me astu",
            "meaning": {
              "literal": "May wisdom be mine.",
              "interpretive": "Wisdom guides action.",
              "applied": "Decision-making."
            }
