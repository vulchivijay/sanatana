    "mantras": [
      {
        "chant_id": "YV-1-1",
        "source_yajurveda": "Vajasaneyi Samhita 1.1",
        "deity": "Savitar",
        "theme": "Consecration",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "ईषे त्वोर्जे त्वा वायवस्थ देवो वः सविता प्रेषयतु श्रेष्ठतमाय कर्मणे",
            "transliteration": "īṣe tvorje tvā vāyavastha devo vaḥ savitā preṣayatu śreṣṭhatamāya karmaṇe",
            "meaning": "For nourishment and strength I take you; may Savitar urge you to the highest ritual act."
          }
        ],
        "chant": {
          "type": "Yajus",
          "delivery": "spoken",
          "intonation": "ritual accentuation",
          "usage": "Opening consecration"
        }
      },
      {
        "chant_id": "YV-1-2",
        "source_yajurveda": "Vajasaneyi Samhita 1.2",
        "deity": "Pavitra",
        "theme": "Purification",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "वसौ पवित्रमसि द्यौरसि पृथिव्यसि मातरिश्वानो घर्मोऽसि विश्वधाया",
            "transliteration": "vasau pavitram asi dyaur asi pṛthivī asi mātariśvāno gharmo'si viśvadhāyā",
            "meaning": "You are the purifier, heaven and earth, Matarishvan, supporter of all."
          }
        ],
        "chant": {
          "type": "Yajus",
          "delivery": "spoken",
          "intonation": "steady ritual tone",
          "usage": "Purifying ritual items"
        }
      },
      {
        "chant_id": "YV-1-3",
        "source_yajurveda": "Vajasaneyi Samhita 1.3",
        "deity": "Savitar",
        "theme": "Purification",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "वसो पवित्रमसि शतधारं सहस्रधारं देवस्त्वां सविता पुनातु",
            "transliteration": "vaso pavitram asi śatadhāraṁ sahasradhāraṁ devas tvāṁ savitā punātu",
            "meaning": "O purifier of a hundred and a thousand streams, may Savitar cleanse you."
          }
        ],
        "chant": {
          "type": "Yajus",
          "delivery": "spoken",
          "intonation": "measured cadence",
          "usage": "Sanctification"
        }
      },
      {
        "chant_id": "YV-1-4",
        "source_yajurveda": "Vajasaneyi Samhita 1.4",
        "deity": "Indra",
        "theme": "Offering allocation",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "सा विश्वायुः सा विश्वकर्मा सा विश्वधाया इन्द्रस्य त्वा भाग सोमेनातनचि",
            "transliteration": "sā viśvāyuḥ sā viśvakarmā sā viśvadhāyā indrasya tvā bhāga somenātanaci",
            "meaning": "Sustaining all life and works, I unite you with Indra’s share by Soma."
          }
        ],
        "chant": {
          "type": "Yajus",
          "delivery": "spoken",
          "intonation": "authoritative",
          "usage": "Portioning the offering"
        }
      },
      {
