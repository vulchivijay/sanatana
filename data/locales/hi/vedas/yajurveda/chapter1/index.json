      {
        "chant_id": "YV-1-17",
        "source_yajurveda": "Vajasaneyi Samhita 1.17",
        "deity": "Savitar",
        "theme": "Activation",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "सविता प्रेषयतु देवो वः कर्मणि",
            "transliteration": "savitā preṣayatu devo vaḥ karmaṇi",
