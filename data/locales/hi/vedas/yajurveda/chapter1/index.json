        "chant_id": "YV-1-20",
        "source_yajurveda": "Vajasaneyi Samhita 1.20",
        "deity": "Indra",
        "theme": "Well-being",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "स्वस्ति न इन्द्रो वृद्धश्रवाः",
