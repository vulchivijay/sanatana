        "source_yajurveda": "Vajasaneyi Samhita 1.16",
        "deity": "Indra-Agni",
        "theme": "Participation",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "अस्मिन्न्यज्ञे बर्हिषि सीदतं नः",
            "transliteration": "asmin yajñe barhiṣi sīdataṁ naḥ",
