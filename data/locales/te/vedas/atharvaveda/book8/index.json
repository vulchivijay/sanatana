      {
        "hymn_id": 26,
        "deity": "Herbs (Oshadhi)",
        "theme": "Healing and medicinal power",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "ओषधयः पचता भेषजं यच्छत रोगनाशनम्।",
            "transliteration": "oṣadhayaḥ pacatā bheṣajaṁ yacchata roganāśanam |",
            "meaning": "O herbs, prepare healing medicine and destroy disease."
          },
          {
            "verse_id": 2,
            "sanskrit": "याः पृथिव्यां विरुधो देवजाता अमृतप्रदाः।",
            "transliteration": "yāḥ pṛthivyāṁ virudho devajātā amṛtapradāḥ |",
            "meaning": "Those plants born of the earth, divine in nature, grant vitality and life."
          }
        ],
        "application": "Used in traditional healing rituals invoking plant-based medicine",
        "philosophy": "Nature is divine healer; plants carry sacred life energy"
      },
  
      {
        "hymn_id": 27,
        "deity": "Water (Apah)",
        "theme": "Purification and vitality",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "आपो हि ष्ठा मयोभुवाः ता न ऊर्जे दधातन।",
            "transliteration": "āpo hi ṣṭhā mayobhuvāḥ tā na ūrje dadhātana |",
            "meaning": "Waters are the source of joy; may they grant us strength and nourishment."
          },
          {
            "verse_id": 2,
            "sanskrit": "आपः शुद्धिं करन्तु मे शरीरस्य च चेतसः।",
            "transliteration": "āpaḥ śuddhiṁ karantu me śarīrasya ca cetasaḥ |",
            "meaning": "May the waters purify both body and mind."
          }
        ],
        "application": "Purification rituals, bathing rites, and healing ceremonies",
        "philosophy": "Water symbolizes both physical and spiritual cleansing"
      },
  
      {
        "hymn_id": 28,
        "deity": "Agni",
        "theme": "Protection and transformation",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "अग्ने रक्ष स्वस्तये सर्वतः पावक दीदिहि।",
            "transliteration": "agne rakṣa svastaye sarvataḥ pāvaka dīdihi |",
            "meaning": "O Agni, protect us for well-being; shine forth from all sides."
          },
          {
            "verse_id": 2,
            "sanskrit": "त्वं पावक विश्ववित् पापं दहसि दूरतः।",
            "transliteration": "tvaṁ pāvaka viśvavit pāpaṁ dahasi dūrataḥ |",
            "meaning": "You, purifier and knower of all, burn away sin from afar."
          }
        ],
        "application": "Fire rituals for protection and purification",
        "philosophy": "Fire transforms impurity into purity"
      },
  
      {
        "hymn_id": 29,
        "deity": "Indra",
        "theme": "Strength and victory",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "इन्द्रः शक्त्या नः पातु जयाय च अभिभूतये।",
            "transliteration": "indraḥ śaktyā naḥ pātu jayāya ca abhibhūtaye |",
            "meaning": "May Indra protect us with strength for victory and dominance."
          },
          {
            "verse_id": 2,
            "sanskrit": "वज्रिणं देवं हवामहे यो नः शत्रून् नुदाति।",
            "transliteration": "vajriṇaṁ devaṁ havāmahe yo naḥ śatrūn nudāti |",
            "meaning": "We invoke Indra, wielder of the thunderbolt, who drives away enemies."
          }
        ],
        "application": "Victory prayers and protection in conflict",
        "philosophy": "Divine strength overcomes obstacles and negativity"
      },
  
      {
        "hymn_id": 30,
        "deity": "Brahman (Cosmic Power)",
        "theme": "Spiritual unity and cosmic order",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "ब्रह्म सर्वं प्रतिष्ठितं यत्र विश्वं निहितं महत्।",
            "transliteration": "brahma sarvaṁ pratiṣṭhitaṁ yatra viśvaṁ nihitaṁ mahat |",
            "meaning": "In Brahman all is established; the entire universe is contained within it."
          },
          {
            "verse_id": 2,
            "sanskrit": "तत् सत्यं ज्ञानमेकं च सर्वभूताधारमुत्तमम्।",
            "transliteration": "tat satyaṁ jñānam ekaṁ ca sarvabhūtādhāram uttamam |",
            "meaning": "That is truth, knowledge, and the supreme foundation of all beings."
          }
        ],
        "application": "Meditative recitation and philosophical contemplation",
        "philosophy": "All existence is rooted in a single universal consciousness"
      }
    ]
  }
