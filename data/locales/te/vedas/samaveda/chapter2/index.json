        "chant_id": "SV-2-1",
        "source_rigveda": "RV 1.12.1",
        "deity": "Agni",
        "theme": "Invocation",
        "verses": [
          {
            "verse_id": 1,
            "sanskrit": "अग्निं दूतं वृणीमहे होतारं विश्ववेदसम्",
            "transliteration": "agniṁ dūtaṁ vṛṇīmahe hotāraṁ viśvavedasam",
            "meaning": "We choose Agni as the divine messenger, the priest who knows all."
          }
        ],
        "chant": {
          "type": "Saman",
          "melody": "opening invocation tone",
          "svara_pattern": "udātta emphasis",
          "usage": "Invocation chant"
        }
